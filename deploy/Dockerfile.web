# Build estático do Next (mesmo export do Capacitor), API no mesmo domínio em /api
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV NEXT_EXPORT=1 NEXT_PUBLIC_API_URL=/api NEXT_TELEMETRY_DISABLED=1
RUN npx next build

FROM nginx:alpine
COPY --from=build /app/out /usr/share/nginx/html
COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
