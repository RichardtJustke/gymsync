FROM golang:1.27-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o /out/api ./cmd/api

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
COPY --from=build /out/api /app/api
WORKDIR /app
ENV PORT=8080
EXPOSE 8080
CMD ["/app/api"]
